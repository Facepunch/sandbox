@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits Panel

<root>

    <div class="presets-toggle" @onclick=@OnToggleClick>
        <i>expand_less</i>
    </div>

</root>

@code
{
    public PlayerInventory Inventory { get; set; }

    void OnToggleClick()
    {
        var menu = new Sandbox.UI.Menu();

        var presets = PlayerLoadout.GetLoadoutPresets();
        foreach ( var preset in presets )
        {
            var name = preset.Name;
            var json = preset.LoadoutJson;
            var sub = menu.AddMenu( name, "bookmark" );
            sub.AddOption( "#spawnmenu.common.load", "play_arrow", () => OnLoadPreset( json ) );
            sub.AddOption( "#ui.inventory.overwrite_preset", "save", () => OnOverwritePreset( name ) );
            sub.AddOption( "#spawnmenu.common.delete", "close", () => OnDeletePreset( name ) );
        }

        if ( presets.Any() )
        {
            menu.AddSeparator();
        }

        menu.AddOption( "#ui.inventory.reset_default", "refresh", ResetToDefault );
        menu.AddOption( "#ui.inventory.new_preset", "add", OnSaveNew );

        menu.Open( this, Popup.PositionMode.AboveLeft, 4 );
    }

    void OnLoadPreset( string json )
    {
        var loadout = GetLoadout();
        if ( !loadout.IsValid() ) return;
        loadout.SwitchToPreset( json );
    }

    void OnOverwritePreset( string name )
    {
        var json = LocalData.Get<string>( "hotbar" );
        if ( string.IsNullOrEmpty( json ) ) return;

        PlayerLoadout.SaveLoadoutPreset( name, json );
    }

    void OnDeletePreset( string name )
    {
        PlayerLoadout.DeleteLoadoutPreset( name );
    }

    void ResetToDefault()
    {
        var loadout = GetLoadout();
        if ( !loadout.IsValid() ) return;
        loadout.ResetToDefault();
    }

    void OnSaveNew()
    {
        var popup = new StringQueryPopup
        {
            Title = "#ui.inventory.new_preset_title",
            Placeholder = "#ui.inventory.preset_name_placeholder",
            ConfirmLabel = "#spawnmenu.common.save",
            OnConfirm = OnSaveConfirmed,
            Parent = FindRootPanel()
        };
    }

    void OnSaveConfirmed( string name )
    {
        var json = LocalData.Get<string>( "hotbar" );
        if ( string.IsNullOrEmpty( json ) ) return;

        PlayerLoadout.SaveLoadoutPreset( name, json );
    }

    PlayerLoadout GetLoadout()
    {
        return Inventory?.GetComponent<PlayerLoadout>();
    }
}
