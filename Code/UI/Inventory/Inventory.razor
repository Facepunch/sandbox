@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent
@implements Global.IPlayerEvents

@if ( !Hud.IsVisible( HudElement.Inventory ) )
    return;

@if ( !inventory.IsValid() )
    return;

<root></root>

@code
{
    [Property, Group( "Sound" )] public SoundEvent SwitchSound { get; set; }

    /// <summary>
    /// Seconds after the last selection change before the menu closes on its own, keeping the current weapon
    /// </summary>
    [Property] public float SelectionTimeout { get; set; } = 1.5f;

    InventorySection Section => HudLayer.Find( this )?.Canvas?.Section<InventorySection>();

    PlayerInventory inventory;
    BaseSandboxWeapon prev;

    BaseSandboxWeapon selected;
    RealTimeSince sinceSelectionChanged;

    bool IsSelecting => selected.IsValid();

    protected override int BuildHash() => HashCode.Combine( inventory, Hud.IsVisible( HudElement.Inventory ) );

    void Global.IPlayerEvents.OnPlayerPickup( PlayerPickupEvent e )
    {
        StateHasChanged();
    }

    bool IsSpawnMenuOpen()
    {
        var host = Game.ActiveScene.Get<SpawnMenuHost>();
        return host?.Panel?.HasClass( "open" ) ?? false;
    }

    protected override void OnUpdate()
    {
        inventory = Game.ActiveScene.GetAllComponents<PlayerInventory>().Where( x => x.Network.IsOwner ).FirstOrDefault();

        // the highlighted weapon was dropped or removed
        if ( selected is not null && (!selected.IsValid() || selected.Inventory != inventory) )
            selected = null;

        if ( Section is not { } section ) return;

        // the menu only shows while picking a weapon
        section.Inventory = inventory;
        section.Selected = selected;
        section.Open = IsSelecting && Hud.IsVisible( HudElement.Inventory );
    }

    protected override void OnDisabled()
    {
        selected = null;
        if ( Section is { } section ) section.Open = false;
    }

    public void HandleInput()
    {
        if ( inventory is null )
            return;

        if ( IsSpawnMenuOpen() )
        {
            selected = null;
            return;
        }

        if ( Input.Pressed( "invprev" ) && prev.IsValid() )
        {
            selected = null;
            var weapon = prev;
            prev = inventory.ActiveWeapon;
            inventory.SwitchWeapon( weapon );
        }

        Step( -(int)Input.MouseWheel.y );
        if ( Input.Pressed( "SlotNext" ) ) Step( 1 );
        if ( Input.Pressed( "SlotPrev" ) ) Step( -1 );

        for ( int i = 0; i < inventory.MaxSlots; i++ )
        {
            if ( Input.Pressed( $"Slot{i + 1}" ) )
                SelectBucket( i );
        }

        if ( !IsSelecting )
            return;

        // don't let the left click fire the weapon at this moment
        if ( Input.Pressed( "attack1" ) )
        {
            Input.ReleaseAction( "attack1" );
            Confirm();
        }
        else if ( Input.Pressed( "attack2" ) )
        {
            Input.ReleaseAction( "attack2" );
            selected = null;
        }
        else if ( sinceSelectionChanged > SelectionTimeout )
        {
            selected = null;
        }
    }

    List<BaseSandboxWeapon> Selectable() => inventory.Weapons.Where( x => x == inventory.ActiveWeapon || inventory.CanSwitchTo( x ) ).ToList();

    /// <summary>
    /// Pressing a bucket's key opens it on its first weapon (or the one after the held weapon), pressing it again steps through the bucket
    /// </summary>
    void SelectBucket( int bucket )
    {
        var items = Selectable().Where( x => x.Slot == bucket ).ToList();
        if ( items.Count == 0 )
            return;

        var from = IsSelecting && selected.Slot == bucket ? selected : inventory.ActiveWeapon;
        var index = items.IndexOf( from );

        SetSelected( items[(index + 1) % items.Count] );
    }

    /// <summary>
    /// The wheel steps through every weapon across all buckets
    /// </summary>
    void Step( int delta )
    {
        if ( delta == 0 )
            return;

        var items = Selectable();
        if ( items.Count == 0 )
            return;

        var index = items.IndexOf( IsSelecting ? selected : inventory.ActiveWeapon );
        if ( index < 0 ) index = delta > 0 ? -1 : 0;

        index = ((index + delta) % items.Count + items.Count) % items.Count;
        SetSelected( items[index] );
    }

    void SetSelected( BaseSandboxWeapon weapon )
    {
        selected = weapon;
        sinceSelectionChanged = 0;
        Sound.Play( SwitchSound );
    }

    void Confirm()
    {
        var weapon = selected;
        selected = null;

        if ( !weapon.IsValid() || weapon == inventory.ActiveWeapon )
            return;

        prev = inventory.ActiveWeapon;
        inventory.SwitchWeapon( weapon );
    }
}
