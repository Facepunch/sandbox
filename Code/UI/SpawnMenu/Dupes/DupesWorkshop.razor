@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Mounting;
@inherits Panel
@namespace Sandbox

<SpawnMenuContent>

    <Header>
        <SpawnMenuToolbar>
            <Left>
                <TextEntry Placeholder="#spawnmenu.common.search" class="filter menu-input" Value:bind=@Filter />
            </Left>
            <Right>
                <UIDropdown class="big" Items=@SortItems Value=@SortOrder ValueChanged=@OnSortChanged />
            </Right>
        </SpawnMenuToolbar>
    </Header>

    <Body>
        @if ( Items.Count == 0 && Loading )
        {
            <UILoadingState />
        }
        else if ( Items.Count == 0 )
        {
            <SpawnMenuEmptyState Icon="search_off" Subtitle="#spawnmenu.empty.try_another_category" />
        }
        else
        {
            <VirtualGrid Items=@Items ItemSize=@(new Vector2( 240, 180 )) OnLastCell="@LoadMore">
                <Item Context="context">

                    @if (context is Storage.QueryItem item)
                    {
                        <WorkshopIcon Item="@item" @onclick=@( () => _ = DuplicatorTool.FromWorkshop( item ) )></WorkshopIcon>
                    }

                </Item>
            </VirtualGrid>
        }
    </Body>

</SpawnMenuContent>

@code
{
    List<UIDropdown.Item> SortItems => UIDropdown.ForEnum<WorkshopSortMode>();

    void OnSortChanged( object value )
    {
        if ( value is WorkshopSortMode mode ) SortOrder = mode;
    }

    string _filter;
    public string Filter
    {
        get => _filter;
        set
        {
            if ( _filter == value ) return;
            _filter = value;
            Rebuild();
        }
    }

    WorkshopSortMode _sortOrder = WorkshopSortMode.Popular;
    public WorkshopSortMode SortOrder
    {
        get => _sortOrder;
        set
        {
            if ( _sortOrder == value ) return;
            _sortOrder = value;
            Rebuild();
        }
    }

    public string Category { get; set; }

    protected override Task OnParametersSetAsync() => Restart();

    List<Storage.QueryItem> Items = new();
    Storage.QueryResult LastResult;
    bool Loading;

    // bumped on every restart so replies to older queries are dropped
    int _queryGeneration;

    // the first load comes from OnParametersSetAsync, initializers shouldn't start one too
    void Rebuild()
    {
        if ( _queryGeneration > 0 ) _ = Restart();
    }

    Task Restart()
    {
        _queryGeneration++;
        Items.Clear();
        LastResult = null;
        return QueryNext();
    }

    void LoadMore()
    {
        if ( Loading ) return;
        _ = QueryNext();
    }

    async Task QueryNext()
    {
        var generation = _queryGeneration;
        Loading = true;

        if ( LastResult != null )
        {
            if ( !LastResult.HasMoreResults() )
            {
                Loading = false;
                return;
            }

            var next = await LastResult.GetNextResults();
            if ( generation != _queryGeneration ) return;

            LastResult = next;
            if ( LastResult?.Items != null )
                Items.AddRange( LastResult.Items );

            Loading = false;
            StateHasChanged();
            return;
        }

        StateHasChanged();

        var query = new Storage.Query();
        query.KeyValues["package"] = "facepunch.sandbox";
        query.KeyValues["type"] = "dupe";
        query.SortOrder = SortOrder.ToSortOrder();

        if ( !string.IsNullOrWhiteSpace( Filter ) ) query.SearchText = Filter;
        if ( Category != null ) query.KeyValues["Category"] = Category;

        var result = await query.Run();
        if ( generation != _queryGeneration ) return;

        LastResult = result;
        if ( LastResult?.Items != null )
            Items.AddRange( LastResult.Items );

        Loading = false;
        StateHasChanged();
    }
}
