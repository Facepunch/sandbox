@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements IUtilityTab
@attribute [Icon( "🔧" )]
@attribute [Title( "#spawnmenu.tab.tools" )]
@attribute [Order( -100 )]

<root class="tab">

    <UIGroupedList Groups=@GetGroups() Selected=@(CurrentMode?.GetType()) OnSelect=@OnSelectTool />

    <UISettingsPane Title=@GetTitle() Revision=@BuildHash()>
        <Body>
        @if ( PostProcessManager?.GetSelectedComponents().Count > 0 )
        {
            @foreach ( var component in PostProcessManager.GetSelectedComponents() )
            {
                <UISheet Target="@component" PropertyFilter="@FilterProperties"></UISheet>
            }
        }
        else
        {
            <UISheet PropertyFilter="@FilterProperties" Target="@GetCurrentMode()"></UISheet>
        }
        </Body>
    </UISettingsPane>

</root>

@code
{
    ToolMode CurrentMode => Player.FindLocalPlayer()?.GetWeapon<Toolgun>()?.GetCurrentMode();
    PostProcessManager PostProcessManager => Game.ActiveScene.GetSystem<PostProcessManager>();

    protected override int BuildHash() => HashCode.Combine( CurrentMode, PostProcessManager?.SelectedPath, PostProcessManager?.GetSelectedComponents().Count, Game.Language.SelectedCode );

    /// <summary>
    /// Every tool under its group, both sorted by what the player reads.
    /// </summary>
    List<UIGroupedList.ListGroup> GetGroups()
    {
        return Game.TypeLibrary.GetTypes<ToolMode>()
            .Where( x => !x.IsAbstract )
            .GroupBy( x => x.Group )
            .OrderBy( x => LocalizedText.Resolve( x.Key ), StringComparer.CurrentCultureIgnoreCase )
            .Select( group => new UIGroupedList.ListGroup( group.Key, group
                .OrderBy( x => LocalizedText.Resolve( x.Title ), StringComparer.CurrentCultureIgnoreCase )
                .Select( x => new UIGroupedList.ListItem( x.Title, x.TargetType ) )
                .ToList() ) )
            .ToList();
    }

    string GetTitle()
    {
        if ( PostProcessManager?.SelectedPath is { } path && PostProcessManager.GetSelectedComponents().Count > 0 )
        {
            var effect = ResourceLibrary.Get<PostProcessResource>( path );
            if ( effect is not null ) return LocalizedText.Resolve( effect.Title );
        }

        return GetCurrentMode()?.Name ?? "";
    }

    void OnSelectTool( object value )
    {
        var type = Game.TypeLibrary.GetTypes<ToolMode>().FirstOrDefault( x => x.TargetType == (value as Type) );
        if ( type is not null ) SwitchMode( type );
    }

    void SwitchMode(TypeDescription t)
    {
        var localPlayer = Player.FindLocalPlayer();
        if ( localPlayer == null ) return;

        PostProcessManager?.Deselect();

        var inventory = localPlayer.GetComponent<PlayerInventory>();
        if ( !inventory.IsValid() ) return;

        inventory.SetToolMode( t.ClassName );
    }

    protected override void OnVisibilityChanged()
    {
        if ( !IsVisible )
        {
            GetCurrentMode()?.SaveCookies();
        }
    }

    ToolMode GetCurrentMode()
    {
        var localPlayer = Player.FindLocalPlayer();
        var toolgun = localPlayer?.GetWeapon<Toolgun>();
        return toolgun?.GetCurrentMode();
    }

    static bool FilterProperties(SerializedProperty o)
    {
        if (o.PropertyType is null) return false;
        if (o.PropertyType.IsAssignableTo(typeof(Delegate))) return false;

        if (o.IsMethod) return true;
        if (!o.HasAttribute<PropertyAttribute>()) return false;

        return true;
    }
}
