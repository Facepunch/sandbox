@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements IUtilityTab
@attribute [Icon("🌍")]
@attribute [Title("#spawnmenu.tab.utilities")]
@attribute [Order(0)]

<root class="tab">

    <UIGroupedList Groups=@GetGroups() Selected=@SelectedPageType?.TargetType OnSelect=@OnSelectPage />

    <UISettingsPane Title=@( SelectedPageType is null ? "" : LocalizedText.Resolve( SelectedPageType.Title ) )>
        <Body><div class="utility-page" @ref="PageContainer"></div></Body>
    </UISettingsPane>

</root>

@code
{
    TypeDescription SelectedPageType { get; set; }
    Panel PageContainer { get; set; }
    UtilityPage ActivePage;

    protected override int BuildHash() => HashCode.Combine( SelectedPageType, Game.Language.SelectedCode );

    List<UIGroupedList.ListGroup> GetGroups()
    {
        return GetPageGroups()
            .Select( group => new UIGroupedList.ListGroup( group.Key, group
                .OrderBy( x => x.Order )
                .ThenBy( x => SortLabel( x.Title ), StringComparer.CurrentCultureIgnoreCase )
                .ThenBy( x => x.FullName, StringComparer.Ordinal )
                .Select( x => new UIGroupedList.ListItem( x.Title, x.TargetType ) )
                .ToList() ) )
            .ToList();
    }

    IEnumerable<IGrouping<string, TypeDescription>> GetPageGroups()
    {
        return GetVisiblePages()
            .GroupBy( x => x.Group )
            .OrderBy( group => group.Min( type => type.Order ) )
            .ThenBy( group => SortLabel( group.Key ), StringComparer.CurrentCultureIgnoreCase )
            .ThenBy( group => group.Key, StringComparer.Ordinal );
    }

    static string SortLabel( string label )
    {
        if ( string.IsNullOrEmpty( label ) ) return "";
        return label.StartsWith( '#' ) ? Game.Language.GetPhrase( label.TrimStart( '#' ) ) : label;
    }

    List<TypeDescription> GetVisiblePages()
    {
        var pages = new List<TypeDescription>();

        foreach ( var type in Game.TypeLibrary.GetTypes<UtilityPage>() )
        {
            if ( type.IsAbstract ) continue;
            var instance = type.Create<UtilityPage>();
            if ( instance is null || !instance.IsPageVisible() ) continue;
            instance.Delete();
            pages.Add( type );
        }

        return pages;
    }

    void OnSelectPage( object value )
    {
        var type = Game.TypeLibrary.GetTypes<UtilityPage>().FirstOrDefault( x => x.TargetType == (value as Type) );
        if ( type is null ) return;

        SelectedPageType = type;

        ActivePage?.Delete();
        ActivePage = type.Create<UtilityPage>();
        PageContainer.AddChild( ActivePage );

        StateHasChanged();
    }
}
