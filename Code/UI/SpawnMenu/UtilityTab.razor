@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements IUtilityTab
@attribute [Icon("🌍")]
@attribute [Title("#spawnmenu.tab.utilities")]
@attribute [Order(0)]

<root class="tab">

    <UIGroupedList Groups=@GetGroups() Selected=@SelectedPage?.Key OnSelect=@OnSelectPage />

    <UISettingsPane Title=@( SelectedPage is null ? "" : LocalizedText.Resolve( SelectedPage.Title ) )>
        <Body><div class="utility-page" @ref="PageContainer"></div></Body>
    </UISettingsPane>

</root>

@code
{
    // either a page type, or a server settings page for one group
    record PageEntry( string Group, string Title, int Order, string SortName, object Key, Func<UtilityPage> Create );

    PageEntry SelectedPage { get; set; }
    Panel PageContainer { get; set; }
    UtilityPage ActivePage;

    protected override int BuildHash() => HashCode.Combine( SelectedPage?.Key, Game.Language.SelectedCode );

    List<UIGroupedList.ListGroup> GetGroups()
    {
        return GetPageGroups()
            .Select( group => new UIGroupedList.ListGroup( group.Key, group
                .OrderBy( x => x.Order )
                .ThenBy( x => LocalizedText.Resolve( x.Title ), StringComparer.CurrentCultureIgnoreCase )
                .ThenBy( x => x.SortName, StringComparer.Ordinal )
                .Select( x => new UIGroupedList.ListItem( x.Title, x.Key ) )
                .ToList() ) )
            .ToList();
    }

    IEnumerable<IGrouping<string, PageEntry>> GetPageGroups()
    {
        return GetVisiblePages()
            .GroupBy( x => x.Group )
            .OrderBy( group => group.Min( page => page.Order ) )
            .ThenBy( group => LocalizedText.Resolve( group.Key ), StringComparer.CurrentCultureIgnoreCase )
            .ThenBy( group => group.Key, StringComparer.Ordinal );
    }

    List<PageEntry> GetVisiblePages()
    {
        var pages = new List<PageEntry>();

        foreach ( var type in Game.TypeLibrary.GetTypes<UtilityPage>() )
        {
            if ( type.IsAbstract ) continue;
            var instance = type.Create<UtilityPage>();
            if ( instance is null ) continue;

            var visible = instance.IsPageVisible();
            instance.Delete();

            if ( visible ) pages.Add( new PageEntry( type.Group, type.Title, type.Order, type.FullName, type.TargetType, () => type.Create<UtilityPage>() ) );
        }

        // one page per server settings group
        if ( ServerSettings.CanEdit )
        {
            var order = 10;
            foreach ( var group in ServerSettings.Groups )
            {
                var settingsGroup = group;
                pages.Add( new PageEntry( "#spawnmenu.utility.group.server", ServerSettings.GroupTitle( group ), order++, group, $"server-settings:{group}", () => new ServerSettingsPage { Group = settingsGroup } ) );
            }
        }

        return pages;
    }

    void OnSelectPage( object value )
    {
        var page = GetVisiblePages().FirstOrDefault( x => Equals( x.Key, value ) );
        if ( page is null ) return;

        SelectedPage = page;

        ActivePage?.Delete();
        ActivePage = page.Create();
        PageContainer.AddChild( ActivePage );

        StateHasChanged();
    }
}
