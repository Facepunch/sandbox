@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Npcs;
@inherits UtilityPage
@namespace Sandbox
@attribute [Icon( "🤖" )]
@attribute [Title( "#spawnmenu.utility.npcs" )]
@attribute [Group( "#spawnmenu.utility.group.world" )]
@attribute [Order( 1 )]

<root class="page" style="flex-direction: column;">
    @if ( Connection.Local.HasPermission( "admin" ) )
    {
        <UISheet Target="@Settings" PropertyFilter="@FilterProperties" />
    }
    else
    {
        <div class="control-row">
            <div class="left"><label>⚠️ </label><label>#spawnmenu.common.host_only</label></div>
        </div>
    }
</root>

@code
{
    public override bool IsPageVisible() => Connection.Local.HasPermission( "admin" );

    readonly NpcSettings Settings = new();

    static bool FilterProperties( SerializedProperty property ) => property.HasAttribute<PropertyAttribute>();

    // Write through the host so the replicated convars change for everyone.
    sealed class NpcSettings
    {
        [Property, Title( "#spawnmenu.utility.ai_enabled" ), Description( "#spawnmenu.utility.ai_enabled_description" ), Order( 0 )]
        public bool AiEnabled
        {
            get => NpcConVars.Enabled;
            set => GameManager.SetConVar( "sandbox.ai.enabled", value );
        }

        [Property, Title( "#spawnmenu.utility.no_target" ), Description( "#spawnmenu.utility.no_target_description" ), Order( 1 )]
        public bool NoTarget
        {
            get => NpcConVars.NoTarget;
            set => GameManager.SetConVar( "sandbox.ai.notarget", value );
        }
    }
}
