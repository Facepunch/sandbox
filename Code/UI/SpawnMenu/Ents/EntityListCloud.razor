@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox


@if ( Entries.Count == 0 && !Loading )
{
    <p>#spawnmenu.entity.no_results</p>
    return;
}



<SpawnMenuContent>

    <Header>
        <SpawnMenuToolbar>
            <Left>
                <TextEntry Placeholder="#spawnmenu.common.search" class="filter menu-input" Value:bind=@Filter />
            </Left>

            <Right>
                <DropDown Value:bind=@SortOrder />
            </Right>
        </SpawnMenuToolbar>
    </Header>

    <Body>
        <VirtualGrid Items=@Entries ItemSize=@(new Vector2( 160, 120 ))>
            <Item Context="item">
                @if (item is ScriptedEntity local)
                {
                    <SpawnMenuIcon Ident=@($"entity:{local.ResourcePath}") Title=@local.Title Developer=@local.Developer Verified=@(true)></SpawnMenuIcon>
                }
                else if (item is Package entry)
                {
                    <SpawnMenuIcon Ident=@($"{entry.TypeName}:{entry.FullIdent}") Title=@entry.Title Verified=@(IsVerified(entry))></SpawnMenuIcon>
                }
            </Item>
        </VirtualGrid>
    </Body>

</SpawnMenuContent>

@code
{
    public string Query { get; set; } = "";
    public string LocalCategory { get; set; }
    public bool IncludeLocalSubcategories { get; set; } = true;
    public bool IncludeLocalEntities { get; set; }
    public string ExcludedLocalCategoryRoot { get; set; }

    private string Filter
    {
        get;
        set { field = value; Rebuild(); }
    }

    public PackageSortMode SortOrder
    {
        get;
        set { field = value; Rebuild(); }
    }

    protected override void OnParametersSet()
    {
        SortOrder = PackageSortMode.Popular;
        Rebuild();
    }

    Package.FindResult LastResult;
    List<object> Entries = [];
    bool Loading;

    async void Rebuild()
    {
        var localEntries = FindLocalEntries().Cast<object>().ToList();
        Entries = localEntries;
        Loading = true;
        StateHasChanged();

        var query = $"sort:{SortOrder.ToIdentifier()} type:sent";
        if ( !string.IsNullOrEmpty( Query ) ) query += $" {Query}";
        if ( !string.IsNullOrEmpty( Filter ) ) query += $" {Filter}";

        LastResult = await Package.FindAsync( query );
        var packages = LastResult.Packages.ToList();

        localEntries.AddRange( packages.Cast<object>() );
        Entries = localEntries;
        Loading = false;
        StateHasChanged();
    }

    static bool IsVerified( Package package ) => string.Equals( package.Org?.Title, "Facepunch", StringComparison.OrdinalIgnoreCase );

    IEnumerable<ScriptedEntity> FindLocalEntries()
    {
        if ( !IncludeLocalEntities && string.IsNullOrWhiteSpace( LocalCategory ) ) return Enumerable.Empty<ScriptedEntity>();

        var entities = ResourceLibrary.GetAll<ScriptedEntity>()
            .Where( entity => !entity.Developer || ServerSettings.ShowDeveloperEntities );

        if ( !string.IsNullOrWhiteSpace( LocalCategory ) )
            entities = entities.Where( entity => SpawnMenuCategory.Matches( entity.Category, LocalCategory, IncludeLocalSubcategories ) );
        if ( !string.IsNullOrWhiteSpace( ExcludedLocalCategoryRoot ) )
            entities = entities.Where( entity => !string.Equals( SpawnMenuCategory.Root( entity.Category ), ExcludedLocalCategoryRoot, StringComparison.OrdinalIgnoreCase ) );

        if ( !string.IsNullOrWhiteSpace( Filter ) )
        {
            entities = entities.Where( entity => (entity.Title ?? "").Contains( Filter, StringComparison.OrdinalIgnoreCase ) || entity.ResourcePath.Contains( Filter, StringComparison.OrdinalIgnoreCase ) );
        }

        return entities.OrderBy( entity => entity.Title ).ThenBy( entity => entity.ResourcePath );
    }


    
}
