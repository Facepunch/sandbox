@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox


@if ( LastResult is null )
{
    // loading
    return;
}

@if ( Packages.Count == 0 )
{
    <p>#spawnmenu.entity.no_results</p>
    return;
}



<SpawnMenuContent>

    <Header>
        <SpawnMenuToolbar>
            <Left>
                <TextEntry Placeholder="#spawnmenu.common.search" class="filter menu-input" Value:bind=@Filter />
            </Left>

            <Right>
                <DropDown Value:bind=@SortOrder />
            </Right>
        </SpawnMenuToolbar>
    </Header>

    <Body>
        <VirtualGrid Items=@Packages ItemSize=@(160)>
            <Item Context="item">
                @if (item is Package entry)
                {
                    <SpawnMenuIcon Ident=@($"{entry.TypeName}:{entry.FullIdent}") Title=@entry.Title></SpawnMenuIcon>
                }
            </Item>
        </VirtualGrid>
    </Body>

</SpawnMenuContent>

@code
{
    public string Query { get; set; } = "";
    public string ExcludedCategoryRoot { get; set; }
    public string IncludedCategoryRoot { get; set; }

    private string Filter
    {
        get;
        set { field = value; Rebuild(); }
    }

    public PackageSortMode SortOrder
    {
        get;
        set { field = value; Rebuild(); }
    }

    protected override void OnParametersSet()
    {
        SortOrder = PackageSortMode.Popular;
        Rebuild();
    }

    Package.FindResult LastResult;
    List<Package> Packages = [];
    readonly Dictionary<string, string> CategoryPaths = [];

    async void Rebuild()
    {
        var query = $"sort:{SortOrder.ToIdentifier()} type:sent";
        if ( !string.IsNullOrEmpty( Query ) ) query += $" {Query}";
        if ( !string.IsNullOrEmpty( Filter ) ) query += $" {Filter}";

        LastResult = await Package.FindAsync( query );
        var packages = LastResult.Packages.ToList();

        if ( !string.IsNullOrWhiteSpace( IncludedCategoryRoot ) || !string.IsNullOrWhiteSpace( ExcludedCategoryRoot ) )
        {
            var categorized = await Task.WhenAll( packages.Select( async package => new { Package = package, Category = await GetCategoryPath( package ) } ) );
            packages = categorized
                .Where( x =>
                {
                    var root = SpawnMenuCategory.Root( x.Category );
                    var isIncluded = string.IsNullOrWhiteSpace( IncludedCategoryRoot ) || string.Equals( root, IncludedCategoryRoot, StringComparison.OrdinalIgnoreCase );
                    var isExcluded = !string.IsNullOrWhiteSpace( ExcludedCategoryRoot ) && string.Equals( root, ExcludedCategoryRoot, StringComparison.OrdinalIgnoreCase );
                    return isIncluded && !isExcluded;
                } )
                .Select( x => x.Package )
                .ToList();
        }

        Packages = packages;
        StateHasChanged();
    }

    async Task<string> GetCategoryPath( Package package )
    {
        if ( CategoryPaths.TryGetValue( package.FullIdent, out var category ) ) return category;

        var entity = await Cloud.Load<ScriptedEntity>( package.FullIdent, true );
        category = entity?.Category ?? "";
        CategoryPaths[package.FullIdent] = category;

        return category;
    }

    
}
