@using Sandbox;
@using Sandbox.UI;

@inherits Panel
@namespace Sandbox


<SpawnMenuContent>

    <Header>
        <SpawnMenuToolbar>
            <Left>
                <TextEntry Placeholder="#spawnmenu.common.search" class="filter menu-input" Value:bind=@Filter />
            </Left>

            <Right>
                <DropDown Value:bind=@SortOrder />
            </Right>
        </SpawnMenuToolbar>
    </Header>

    <Body>
<VirtualGrid Items=@Entries ItemSize=@(120)>
    <Item Context="item">
        @if (item is LocalProps.Entry local)
        {
            <SpawnMenuIcon Ident=@($"prop:{local.Path}") Title=@local.DisplayName Verified=@(true) />
        }
        else if (item is Package entry)
        {
            <SpawnMenuIcon Ident=@($"prop:{entry.FullIdent}") Title=@entry.Title Verified=@(IsVerified(entry)) />
        }
    </Item>
</VirtualGrid>
    </Body>

</SpawnMenuContent>

@code
{
    public string Category { get; set; } = "";
    public string LocalCategory { get; set; }
    public bool IncludeLocalProps { get; set; }

    private string Filter
    {
        get;
        set { field = value; Rebuild(); }
    }

    public PackageSortMode SortOrder
    {
        get;
        set { field = value; Rebuild(); }
    }

    protected override void OnParametersSet()
    {
        SortOrder = PackageSortMode.Popular;
        Rebuild();
    }

    List<object> Entries = [];

    async void Rebuild()
    {
        var localEntries = FindLocalEntries().Cast<object>().ToList();
        Entries = localEntries;
        StateHasChanged();

        var query = $"sort:{SortOrder.ToIdentifier()} type:model";
        if ( !string.IsNullOrEmpty( Filter ) ) query += $" {Filter} ";
        if ( !string.IsNullOrEmpty( Category ) ) query += $" category:{Category}";

        var result = await Package.FindAsync( query );
        localEntries.AddRange( result.Packages.Cast<object>() );
        Entries = localEntries;
        StateHasChanged();
    }
    static bool IsVerified( Package package ) => string.Equals( package.Org?.Title, "Facepunch", StringComparison.OrdinalIgnoreCase );


    string LocalFilterCategory => string.IsNullOrWhiteSpace( LocalCategory ) ? Category : LocalCategory;
    IEnumerable<LocalProps.Entry> FindLocalEntries()
    {
        if ( !IncludeLocalProps && string.IsNullOrWhiteSpace( LocalFilterCategory ) ) return Enumerable.Empty<LocalProps.Entry>();

        var entries = string.IsNullOrWhiteSpace( LocalFilterCategory )
            ? LocalProps.All
            : LocalProps.All.Where( entry => string.Equals( entry.Category, LocalFilterCategory, StringComparison.OrdinalIgnoreCase ) );

        if ( !string.IsNullOrWhiteSpace( Filter ) )
            entries = entries.Where( entry => entry.DisplayName.Contains( Filter, StringComparison.OrdinalIgnoreCase ) || entry.Path.Contains( Filter, StringComparison.OrdinalIgnoreCase ) );

        return entries.OrderBy( entry => entry.DisplayName ).ThenBy( entry => entry.Path );
    }
}
