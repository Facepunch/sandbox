@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( !Hud.IsVisible( HudElement.ToolInfo ) )
    return;

@if ( Info is null )
    return;

<root>
 <div class="header">
  <div class="tint" style=@TintStyle />

  <div class="grid-mask">
   <div class="grid" />
  </div>

  <Label class="title" Tokenize=@false Text=@LocalizedText.Resolve( Info.Name ) />

  @if ( !string.IsNullOrEmpty( Info.Description ) )
  {
   <Label class="description" Tokenize=@false Text=@LocalizedText.Resolve( Info.Description ) />
  }
 </div>

 @if ( HasAnyAction )
 {
  <div class="hints">
   @if ( !string.IsNullOrEmpty( Info.PrimaryAction ) )
   {
    <div class="hint">
     <InputHint Action="attack1" class="key" />
     <Label class="text" Tokenize=@false Text=@LocalizedText.Resolve( Info.PrimaryAction ) />
    </div>
   }
   @if ( !string.IsNullOrEmpty( Info.SecondaryAction ) )
   {
    <div class="hint">
     <InputHint Action="attack2" class="key" />
     <Label class="text" Tokenize=@false Text=@LocalizedText.Resolve( Info.SecondaryAction ) />
    </div>
   }
   @if ( !string.IsNullOrEmpty( Info.ReloadAction ) )
   {
    <div class="hint">
     <InputHint Action="reload" class="key" />
     <Label class="text" Tokenize=@false Text=@LocalizedText.Resolve( Info.ReloadAction ) />
    </div>
   }
  </div>
 }
</root>

@code
{
	IToolInfo CurrentToolInfo
	{
		get
		{
			var inv = Player?.GetComponent<PlayerInventory>();

			if ( !inv.IsValid() || !inv.ActiveWeapon.IsValid() )
				return null;

			if ( inv.ActiveWeapon.GetComponentInChildren<IToolInfo>() is { IsValid: true } toolInfo )
				return toolInfo;

			return inv?.ActiveWeapon as IToolInfo;
		}
	}

	Player Player => Player.FindLocalPlayer();

	IToolInfo Info => CurrentToolInfo;

	bool HasAnyAction => !string.IsNullOrEmpty( Info?.PrimaryAction )
	                     || !string.IsNullOrEmpty( Info?.SecondaryAction )
	                     || !string.IsNullOrEmpty( Info?.ReloadAction );

	const float TintAlpha = 0.6f;

	Color HudTint => ( HudLayer.Find( this, false )?.Tint ?? new Color( 0.43f, 0.74f, 1f ) ) * 0.75f;

	string TintStyle
	{
		get
		{
			var c = HudTint;
			var rgb = $"{(int)(c.r * 255)}, {(int)(c.g * 255)}, {(int)(c.b * 255)}";
			return $"background-image: linear-gradient( to right, rgba( {rgb}, {TintAlpha} ), rgba( {rgb}, 0 ) );";
		}
	}

	protected override void OnUpdate()
	{
		SetClass( "visible", CurrentToolInfo is not null );
	}

	protected override int BuildHash() => System.HashCode.Combine( Info?.Name, Info?.Description, Info?.PrimaryAction, Info?.SecondaryAction, Info?.ReloadAction, Hud.IsVisible( HudElement.ToolInfo ), Game.Language.SelectedCode, HudTint );
}
