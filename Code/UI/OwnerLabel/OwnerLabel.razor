@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
</root>

@code
{
    // The label is painted by the shared HUD layer (see HudLayer, OwnerLabelSection)
    OwnerLabelSection section;
    string _name, _language, _text;

    protected override void OnDisabled()
    {
        if ( section is not null ) section.Text = null;
    }

	protected override void OnUpdate()
	{
        section = HudLayer.FindSection( this, section );
        if ( section is null ) return;

        var name = FindOwnerName();
        if ( name != _name || Game.Language.SelectedCode != _language )
        {
            _name = name;
            _language = Game.Language.SelectedCode;
            _text = name is null ? null : Game.Language.GetPhrase( "ui.owner.owned_by", new() { { "name", name } } );
        }

        section.Text = _text;
	}

    string FindOwnerName()
    {
		var camera = Scene.Camera;
        if ( camera is null || !Hud.IsVisible( HudElement.OwnerLabel ) ) return null;

		var tr = Scene.Trace
			.Ray( camera.Transform.World.ForwardRay, 2048 )
			.WithoutTags( "player", "trigger" )
			.Run();

		if ( !tr.Hit || !tr.GameObject.IsValid() ) return null;

		var ownable = tr.GameObject.GetComponentInParent<Ownable>( true );
		return ownable.IsValid() ? ownable.Owner?.DisplayName : null;
    }

	protected override int BuildHash() => 0;
}
