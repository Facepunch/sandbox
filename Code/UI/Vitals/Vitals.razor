@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( !Player.IsValid() )
    return;

<root>
    <AmmoPickupFeed />
    <VitalsCanvas @ref="Canvas" />
</root>

@code
{
    /// <summary>
    /// Colour multiplied into every HUD element
    /// </summary>
    [Property] public Color Tint { get; set; } = Color.White;

    /// <summary>
    /// HDR color exponent for digits in HUD
    /// </summary>
    [Property, Group( "Effects" ), Range( 0, 6 )] public float DigitExponent { get; set; } = 3;

    /// <summary>
    /// HDR color exponent for text in HUD
    /// </summary>
    [Property, Group( "Effects" ), Range( 0, 6 )] public float TextExponent { get; set; } = 1.25f;

    [Property, Group( "Effects" ), Range( 0, 1 )] public float GlowStrength { get; set; } = 0.15f;

    [Property, Group( "Effects" ), Range( 0, 48 )] public float GlowRadius { get; set; } = 16;

    [Property, Group( "Effects" ), Range( 0, 1 )] public float ScanlineIntensity { get; set; } = 0.35f;

    /// <summary>
    /// Scanline frequency in pixels
    /// </summary>
    [Property, Group( "Effects" ), Range( 2, 12 )] public float ScanlinePeriod { get; set; } = 3;

    [Property, Group( "Effects" ), Range( 0, 1 )] public float ScanlineThickness { get; set; } = 0.8f;

    [Property, Group( "Effects" ), Range( 0, 1 )] public float ScanlineSoftness { get; set; } = 1f;

    VitalsCanvas Canvas { get; set; }

    Player Player => Player.FindLocalPlayer();
    BaseSandboxWeapon Weapon => Player?.GetComponent<PlayerInventory>()?.ActiveWeapon as BaseSandboxWeapon;

    bool IsSpawnMenuOpen()
    {
        var host = Game.ActiveScene.Get<SpawnMenuHost>();
        return host?.Panel?.HasClass( "open" ) ?? false;
    }

    protected override void OnUpdate()
    {
        if ( !Canvas.IsValid() || !Player.IsValid() ) return;

        var weapon = Weapon;
        var showAmmo = weapon.IsValid() && weapon.UsesAmmo && Hud.IsVisible( HudElement.Ammo );

        Canvas.Tint = Tint;
        Canvas.DigitExponent = DigitExponent;
        Canvas.TextExponent = TextExponent;
        Canvas.GlowStrength = GlowStrength;
        Canvas.GlowRadius = GlowRadius;
        Canvas.ScanlineIntensity = ScanlineIntensity;
        Canvas.ScanlinePeriod = ScanlinePeriod;
        Canvas.ScanlineThickness = ScanlineThickness;
        Canvas.ScanlineSoftness = ScanlineSoftness;
        Canvas.Hidden = IsSpawnMenuOpen();
        Canvas.Data = new VitalsCanvas.Readout
        {
            ShowVitals = Hud.IsVisible( HudElement.Vitals ),
            Health = (int)Player.Health,
            Armour = (int)Player.Armour,

            ShowAmmo = showAmmo,
            UsesClips = showAmmo && weapon.UsesClips,
            Clip = showAmmo ? weapon.Clip1 : 0,
            ClipMaxSize = showAmmo ? weapon.ClipMaxSize : 0,
            Reserve = showAmmo ? weapon.Ammo1 : 0,

            HasSecondary = showAmmo && HasSecondaryAmmo( weapon ),
            Secondary = showAmmo ? SecondaryAmmo( weapon ) : 0,
        };
    }

    static bool HasSecondaryAmmo( BaseSandboxWeapon weapon ) => weapon.UsesSecondaryClip || weapon.SecondaryAmmoType is not null;

    static int SecondaryAmmo( BaseSandboxWeapon weapon )
    {
        if ( weapon.UsesSecondaryClip ) return System.Math.Max( weapon.Clip2, 0 );
        return weapon.SecondaryAmmoType is not null ? weapon.Ammo2 : 0;
    }

    protected override int BuildHash() => System.HashCode.Combine( Player.IsValid() );
}
