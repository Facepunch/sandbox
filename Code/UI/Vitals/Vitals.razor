@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

@if ( !Player.IsValid() )
    return;

<root>
    <AmmoPickupFeed />
    <VitalsCanvas @ref="Canvas" />
</root>

@code
{
    /// <summary>
    /// Colour multiplied into every HUD element
    /// </summary>
    [Property] public Color Tint { get; set; } = Color.White;

    VitalsCanvas Canvas { get; set; }

    Player Player => Player.FindLocalPlayer();
    BaseSandboxWeapon Weapon => Player?.GetComponent<PlayerInventory>()?.ActiveWeapon as BaseSandboxWeapon;

    bool IsSpawnMenuOpen()
    {
        var host = Game.ActiveScene.Get<SpawnMenuHost>();
        return host?.Panel?.HasClass( "open" ) ?? false;
    }

    protected override void OnUpdate()
    {
        if ( !Canvas.IsValid() || !Player.IsValid() ) return;

        var weapon = Weapon;
        var showAmmo = weapon.IsValid() && weapon.UsesAmmo && Hud.IsVisible( HudElement.Ammo );

        Canvas.Tint = Tint;
        Canvas.Hidden = IsSpawnMenuOpen();
        Canvas.Data = new VitalsCanvas.Readout
        {
            ShowVitals = Hud.IsVisible( HudElement.Vitals ),
            Health = (int)Player.Health,
            Armour = (int)Player.Armour,

            ShowAmmo = showAmmo,
            UsesClips = showAmmo && weapon.UsesClips,
            Clip = showAmmo ? weapon.Clip1 : 0,
            ClipMaxSize = showAmmo ? weapon.ClipMaxSize : 0,
            Reserve = showAmmo ? weapon.Ammo1 : 0,
        };
    }

    protected override int BuildHash() => System.HashCode.Combine( Player.IsValid() );
}
